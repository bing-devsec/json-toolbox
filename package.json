{
  "name": "json-tool-extension",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-local-only.mjs && node scripts/write-build-info.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import ./scripts/register-typescript-tests.mjs --test --test-concurrency=2 tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "element-plus": "2.13.7",
    "@element-plus/icons-vue": "2.3.2",
    "monaco-editor": "0.52.2",
    "diff": "9.0.0",
    "histogram-diff": "0.1.1",
    "js-base64": "3.7.8",
    "js-yaml": "4.3.2",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.8",
    "@types/node": "22.19.17",
    "@types/js-yaml": "4.0.9",
    "@types/diff": "7.0.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
